{
  "name": "Only dev and main exist",
  "target": "branch",
  "enforcement": "active",
  "bypass_actors": [
    {
      "actor_id": 1,
      "actor_type": "OrganizationAdmin",
      "bypass_mode": "always"
    },
    {
      "actor_id": 5,
      "actor_type": "RepositoryRole",
      "bypass_mode": "always"
    }
  ],
  "conditions": {
    "ref_name": {
      "include": [
        "~ALL"
      ],
      "exclude": [
        "refs/heads/main",
        "refs/heads/dev",
        "refs/heads/dependabot/**"
      ]
    }
  },
  "rules": [
    {
      "type": "creation"
    }
  ]
}
