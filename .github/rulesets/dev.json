{
  "name": "Commit message format",
  "target": "branch",
  "enforcement": "active",
  "bypass_actors": [
    { "actor_id": 1, "actor_type": "OrganizationAdmin", "bypass_mode": "always" },
    { "actor_id": 5, "actor_type": "RepositoryRole", "bypass_mode": "always" }
  ],
  "conditions": {
    "ref_name": { "include": ["~ALL"], "exclude": [] }
  },
  "rules": [
    {
      "type": "commit_message_pattern",
      "parameters": {
        "name": "Tagged commit messages",
        "operator": "regex",
        "negate": false,
        "pattern": "^(\\[(DEV|BUGFIX|REFACTO|DOC|TEST|CI|PERF|SECURITY|BREAKING|RELEASE|REVERT|CHORE)\\]: .+|Merge )"
      }
    }
  ]
}
